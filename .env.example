# Shared defaults for every EUDM CLI.
# Copy this file to .env and edit it. The real .env is gitignored.

# Request/authentication
EUDM_REQUEST_FOR=your.login
EUDM_BROWSER_PROFILE=~/.auto-eudm-chrome
# Set true after SSO is known to work automatically in the dedicated profile.
EUDM_BROWSER_HEADLESS=false
EUDM_BASE=https://macquarie-dwp.onbmc.com/dwp/rest

# Default Sydney location used when location arguments are omitted
EUDM_CITY="Sydney, AU"
EUDM_BUILDING="1 Elizabeth Street"
EUDM_FLOOR="Level 15"
EUDM_ROOM="Store Room"
EUDM_CABINET=

# Default submitted values
# Used stock is EUDM's "Deployed - Existing Stock" user status.
EUDM_DEFAULT_USER_STATUS="Deployed - Existing Stock"
EUDM_DEFAULT_LOCATION_STATUS="Used Stock"

# Enable the spreadsheet workflow. It asks you to map columns from each workbook.
EUDM_ENABLE_SPREADSHEET_IMPORT=true

# CLI and localhost-web behavior. Command-line flags override these values.
EUDM_SIMULATE=true
EUDM_VERBOSE=false
EUDM_LOGGING=false
# Independent web/CLI requests can run in parallel. Start at 2-3 if EUDM is responsive.
EUDM_CONCURRENCY=1
EUDM_MANUAL_REVIEW=false

# Dependency setup. By default each CLI creates .venv and installs what it needs.
# EUDM_SKIP_AUTO_INSTALL=true
# EUDM_VENV_DIR=/Users/your-name/.venvs/auto-eudm

# Do not store EUDM_COOKIE here. Export short-lived cookies only in the shell.
