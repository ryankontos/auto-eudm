# Shared defaults for every DWP CLI.
# Copy this file to .env and edit it. The real .env is gitignored.

# Request/authentication
DWP_REQUEST_FOR=your.login
DWP_BROWSER_PROFILE=~/.dwp-device-request-chrome
DWP_BASE=https://macquarie-dwp.onbmc.com/dwp/rest

# Default Sydney location used when location arguments are omitted
DWP_CITY="Sydney, AU"
DWP_BUILDING="1 Elizabeth Street"
DWP_FLOOR="Level 15"
DWP_ROOM="Store Room"
DWP_CABINET=

# Default submitted values
# Used stock is DWP's "Deployed - Existing Stock" user status.
DWP_DEFAULT_USER_STATUS="Deployed - Existing Stock"
DWP_DEFAULT_LOCATION_STATUS="Used Stock"

# CLI behavior. Command-line flags override these values.
DWP_SIMULATE=false
DWP_VERBOSE=false
DWP_MANUAL_REVIEW=false

# Do not store DWP_COOKIE here. Export short-lived cookies only in the shell.
